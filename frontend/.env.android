# Android Development Environment Config
# Note: When testing on Android Emulator, http://10.0.2.2:5000/api connects to host PC localhost:5000.
# For physical Android devices on local Wi-Fi, change this to your LAN IP e.g. http://192.168.1.5:5000/api
VITE_API_BASE_URL=http://10.0.2.2:5000/api
VITE_ENV=android
